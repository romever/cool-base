{
  "name": "cool-base",
  "version": "1.0.0",
  "private": true,
  "description": "基于 cool-admin 的通用后台框架（server: midway 后端，admin: vue 管理端）",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter server run dev",
    "dev:admin": "pnpm --filter admin run dev",
    "build": "pnpm -r run build",
    "build:server": "pnpm --filter server run build",
    "build:admin": "pnpm --filter admin run build",
    "start:server": "pnpm --filter server run start"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.1"
}
